total=0; stopped=0; i=0
while [ "$i" -lt 5 ]; do
  total=0; stopped=0
  for d in /proc/[0-9]*; do
    c=$(cat "$d/comm" 2&gt;/dev/null) || continue
    [ "$c" = "$want" ] || continue
    total=$((total + 1))
    st=$(sed -n 's/^State:[[:space:]]*//p' "$d/status" 2&gt;/dev/null | cut -c1)
    case "$st" in T|t) stopped=$((stopped + 1)) ;; esac
  done
  # 已经有 T 状态进程 → 注入生效；一个匹配进程都没有 → 目标写错，重试也没用
  if [ "$stopped" -gt 0 ] || [ "$total" -eq 0 ]; then break; fi
  i=$((i + 1)); sleep 1
done
